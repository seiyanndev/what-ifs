.env

# Ignore the output video from Git but not videos you import into src/.
out
*.zip

# Local speech-to-text install (whisper.cpp source + models), created by `npm run audio:setup`
whisper.cpp/
# Raw recordings stay local; the cleaned voice + timestamps are what episodes use
public/voice/*/raw.*
# Generated by `npm run sounds` (also runs automatically after npm install)
public/sfx/
public/music/
# Local narrator (Kokoro) — created by `npm run voice:setup`
.venv-tts/
tts-models/

# Generated per episode by `npm run episode`
episodes/*/timeline.json
episodes/*/.thumb-props.json
episodes/*/.timeline-*.json
